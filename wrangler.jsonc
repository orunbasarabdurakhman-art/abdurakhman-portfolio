{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abdurakhman-portfolio",
  "compatibility_date": "2026-09-17",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "build": {
    "command": "npm install && npm run build"
  },
  "observability": {
    "enabled": true
  }
}
